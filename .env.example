# Server-side only. Never expose this value in client-side code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Client-safe Supabase values for Auth magic links and study rooms.
# Get these from Supabase Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Required for sending invite emails from the app.
# Supabase docs call this the secret key. Never expose it as NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
